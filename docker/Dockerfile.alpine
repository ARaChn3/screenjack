# Alpine/musl static build - portable binary works on any Linux
FROM alpine:latest

ARG EMBED=false

RUN apk add --no-cache \
    rust cargo \
    musl-dev \
    libxcb-dev \
    libxcb-static

WORKDIR /src
COPY payload/ ./
COPY docker/.embed-asset /tmp/

RUN if [ "$EMBED" = "true" ]; then \
        SCREENJACK_ASSET=/tmp/.embed-asset cargo build --release --features embedded; \
    else \
        cargo build --release; \
    fi && strip target/release/screenjack

# Output: /src/target/release/screenjack
